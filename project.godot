; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot Blueprint C#"
config/tags=PackedStringArray("template")
run/main_scene="uid://gfyfq0xsq0ak"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
run/max_fps=60
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="uid://dgq0o6xp228ku"
config/icon="res://icon.png"

[autoload]

FpsCounter="*uid://c5uyymg5ddoce"
SaveManager="*uid://utwfaywa0i1"
SignalBus="*uid://df5aal2e3djlm"
UIHolder="*uid://bqyskvc28oyhb"

[debug]

shader_language/warnings/treat_warnings_as_errors=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/initial_position_type=3
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Game"
project/solution_directory="."

[editor_plugins]

enabled=PackedStringArray()

[file_customization]

folder_colors={
"res://assets/": "green",
"res://assets/external/": "gray",
"res://core/": "blue",
"res://scenes/": "pink",
"res://tests/": "red"
}

[filesystem]

import/fbx2gltf/enabled=false
import/blender/enabled=false
import/fbx/enabled=false

[physics]

3d/physics_engine="Jolt Physics"
common/enable_pause_aware_picking=true

[rendering]

environment/default_environment="res://default_env.tres"
