{
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet tool restore:*)",
      "Bash(dotnet csharpier:*)",
      "Bash(npm run build:*)",
      "Bash(npm test:*)",
      "Bash(npm run format:*)",
      "Bash(npm run smoke:*)",
      "Bash(npm run check:*)",
      "Bash(npm run import:*)",
      "Bash(npm run new:scene:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-csharp.mjs\""
          }
        ]
      }
    ]
  }
}
